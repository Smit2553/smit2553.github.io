# App environment: "development" or "production".
BLOG_APP_ENV=development

# Postgres connection and schema.
DATABASE_URL=postgres://user:password@localhost:5432/blog
BLOG_DB_SCHEMA=blog_dev

# Local-only fallback admin credentials are enabled by npm run dev.
# Do not enable this in production.
BLOG_ALLOW_DEV_ADMIN_DEFAULTS=1

# Required in production. Optional in local dev when BLOG_ALLOW_DEV_ADMIN_DEFAULTS=1.
BLOG_ADMIN_USERNAME=admin
BLOG_ADMIN_PASSWORD=replace-with-a-strong-password

# Required in production. Must be at least 32 characters.
BLOG_VISITOR_COOKIE_SECRET=replace-with-at-least-32-random-characters

